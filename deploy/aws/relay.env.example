# Copied to deploy/aws/relay.env by deploy-backend.sh. relay.env is git-ignored: it holds secrets.
AWS_REGION=ap-south-1
# Your Amplify app address (Amplify console -> the app -> Domain), e.g. https://main.d1abc2def3.amplifyapp.com
FRONTEND_URL=
# demo = sample departments, people and bookings (shared demo password); org = organization only; none = empty
SEED_ON_START=demo
# Email: Amazon SES SMTP credentials (or any SMTP provider). Leave blank to skip email for now.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Relay <no-reply@example.org>"
# DB_PASSWORD and CRON_KEY are generated on the first run and appended below.
